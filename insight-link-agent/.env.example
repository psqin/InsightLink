# InsightLink Agent 配置模板：36项应用配置 + 9项Docker部署配置。
# 首次复制为根目录 .env 并填写；已有 .env 不要覆盖。
# .env 保存实际值，本文件集中说明用途、默认值和部署注意事项。
# 本机 Python 与 Docker Compose 均读取根目录 .env。
# 修改后本机重启服务；Docker执行 docker compose up -d，修改代码时加 --build。
# 字符串建议使用单引号；真实密钥、密码和带凭据的数据库URI不要上传。

# ===== 1. 主模型与辅助模型 =====
# 主对话模型名称；必填。
MODEL_NAME=
# 主对话模型密钥；必填，不要上传真实密钥。
MODEL_API_KEY=
# 模型接口地址；兼容接口填写其 base URL，留空使用 SDK 默认地址。
MODEL_BASE_URL=
# 摘要、配置授权和评价复核使用的辅助模型；留空沿用主模型。
REVIEW_MODEL_NAME=

# ===== 2. 业务接口与浏览器 =====
# 本机 Python 使用的 Java 地址；Docker 使用第8组的 DOCKER_JAVA_BASE_URL。
JAVA_BASE_URL='http://127.0.0.1:8080'
# 允许调用 Agent 的浏览器站点来源，多个用逗号分隔。
CORS_ORIGINS='http://localhost:5173,http://127.0.0.1:5173'

# ===== 3. MongoDB 与数据归属 =====
# 本机 Python 使用的 MongoDB 地址；Docker 使用第8组的 DOCKER_MONGODB_URL。
MONGODB_URL='mongodb://127.0.0.1:27017'
# 数据库名称；两种运行方式共用，不要误改导致读到另一数据库。
MONGODB_DATABASE='insight_link_agent'
# 集合名前缀；影响聊天、记忆、评分标准、检查点等全部集合。
MONGODB_COLLECTION='insight_link_agent'

# ===== 4. 沙箱与附件 =====
# 仅本机 Python 使用的已命名 Docker Context；Compose 内固定 default，通过宿主 socket 连接。
DOCKER_CONTEXT='default'
# 允许下载附件的域名，多个用逗号分隔；仅 HTTPS，留空不下载附件。
ATTACHMENT_ALLOWED_HOSTS=
# 单份附件下载上限，单位字节；默认5000000。
ATTACHMENT_MAX_BYTES=5000000
# 附件解析镜像标签；Compose 按此名称构建，本机运行需事先准备。
ATTACHMENT_SANDBOX_IMAGE='insight-link-attachment-parser:latest'
# 附件解析超时，单位秒；默认30。
ATTACHMENT_TIMEOUT_SECONDS=30
# 分析镜像标签；Compose 按此名称构建，本机运行需事先准备。
ANALYSIS_SANDBOX_IMAGE='insight-link-analysis:latest'
# 分析超时，单位秒；允许5–90，默认30。
ANALYSIS_TIMEOUT_SECONDS=30

# ===== 5. 分页与评价草稿 =====
# 材料历史查询页数预算；默认5。
MAX_HISTORY_PAGES=5
# 授权元数据查询最大页数；允许1–1000，默认100。
MAX_SEARCH_PAGES=100
# 一轮批量取数工具调用预算；允许8–256，默认128。
BULK_QUERY_CALL_LIMIT=128
# 评价页面草稿复核的修订次数上限；默认2，不是普通聊天的统一复核。
MAX_REVISIONS=2

# ===== 6. 上下文压缩 =====
# 模型输入窗口预算；按所用模型调整，允许4096–2000000。
CONTEXT_MAX_INPUT_TOKENS=32768
# 达到窗口的该比例时触发压缩；允许0.5–0.95，默认0.85。
CONTEXT_TRIGGER_RATIO=0.85
# 压缩后保留的近期消息数量；允许2–50，默认8。
CONTEXT_KEEP_MESSAGES=8
# 历史工具参数保留的字符预算；允许200–20000，默认2000。
CONTEXT_MAX_ARGUMENT_CHARS=2000
# 历史工具结果的 token 预算；允许500–100000，默认6000。
CONTEXT_TOOL_RESULT_TOKENS=6000
# 摘要输出 token 上限；允许200–8000，默认2000。
CONTEXT_SUMMARY_MAX_TOKENS=2000
# 摘要调用超时，单位秒；允许5–120，默认45。
CONTEXT_SUMMARY_TIMEOUT_SECONDS=45

# ===== 7. 公开网页与脱敏观测 =====
# DeepSeek 网页搜索专用密钥；留空时尝试下方 DEEPSEEK_API_KEY，不复用 MODEL_API_KEY。
WEB_SEARCH_API_KEY=
# 可选的 DeepSeek 搜索备用密钥；不使用该功能可留空。
DEEPSEEK_API_KEY=
# 公开搜索的模型名称。
WEB_SEARCH_MODEL='deepseek-v4-pro'
# 公开搜索使用的 DeepSeek Responses 接口地址。
DEEPSEEK_RESPONSES_URL='https://api.deepseek.com/responses'
# 是否启用脱敏观测；true/false，默认false，不启用原文自动追踪。
LANGSMITH_ENABLED=false
# LangSmith 密钥；观测关闭时可留空。
LANGSMITH_API_KEY=
# LangSmith 项目名称。
LANGSMITH_PROJECT='insight-link-agent'
# LangSmith API 地址。
LANGSMITH_ENDPOINT='https://api.smith.langchain.com'
# 可选工作区 ID；通常留空。
LANGSMITH_WORKSPACE_ID=

# ===== 8. Docker Compose 部署（本机 Python 忽略以下字段） =====
# 部署主机监听地址；127.0.0.1仅本机/反向代理可访问，0.0.0.0允许其他机器访问。
AGENT_BIND_ADDRESS='127.0.0.1'
# 部署主机发布端口；默认8001，Agent容器内部仍监听8001。
AGENT_PORT=8001
# Java在Docker宿主上用http://host.docker.internal:8080；在其他机器填可访问的IP/域名，不能填localhost。
DOCKER_JAVA_BASE_URL='http://host.docker.internal:8080'
# 默认mongodb://mongodb:27017连接内置Mongo；沿用旧记忆时填写容器可访问的原库URI，不会自动迁移数据。
DOCKER_MONGODB_URL='mongodb://mongodb:27017'
# Agent镜像标签；Compose按此名称构建。
AGENT_IMAGE='insight-link-agent:latest'
# 内置Mongo镜像；升级前确认数据版本兼容。
MONGODB_IMAGE='mongo:8.0'
# 宿主Docker socket路径；一般/var/run/docker.sock，仅挂载给Agent，沙箱不能访问。
DOCKER_SOCKET_PATH='/var/run/docker.sock'
# Agent容器内存上限；支持1g、512m等Docker大小格式。
AGENT_MEMORY_LIMIT='1g'
# 内置Mongo容器内存上限；默认768m。
MONGODB_MEMORY_LIMIT='768m'
